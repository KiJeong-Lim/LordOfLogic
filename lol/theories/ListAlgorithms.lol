(* Stable filtering, lookup/update, zipping and accumulator reversal. *)
Import lol.theories.Logic.
Import lol.theories.Nat.
Import lol.theories.Bool.
Import lol.theories.List.
Import lol.theories.ListProperties.
Import lol.theories.ListRelations.
Import lol.theories.OptionProperties.

Definition select_cons {A : Set} (b : bool) (x : A) (l : list A) : list A := match b with | true => cons x l | false => l end.
Definition partition {A : Set} (p : A -> bool) (l : list A) : prod (list A) (list A) := pair (list A) (list A) (filter p l) (filter (fun x => negb (p x)) l).
Fixpoint find {A : Set} (p : A -> bool) (l : list A) : option A := match l with | nil _ => None A | cons x t => match p x with | true => Some A x | false => find p t end end.
Fixpoint update {A : Set} (n : nat) (x : A) (l : list A) {struct l} : list A := match l with | nil _ => nil A | cons y t => match n with | O => cons x t | S k => cons y (update k x t) end end.
Fixpoint zip_with {A B C : Set} (f : A -> B -> C) (l : list A) (m : list B) {struct l} : list C := match l with | nil _ => nil C | cons x t => match m with | nil _ => nil C | cons y u => cons (f x y) (zip_with f t u) end end.
Definition unzip {A B : Set} (l : list (prod A B)) : prod (list A) (list B) := pair (list A) (list B) (map (fst A B) l) (map (snd A B) l).
Fixpoint rev_append {A : Set} (l m : list A) {struct l} : list A := match l with | nil _ => m | cons x t => rev_append t (cons x m) end.
Definition rev_fast {A : Set} (l : list A) : list A := rev_append l (nil A).
Fixpoint count {A : Set} (p : A -> bool) (l : list A) : nat := match l with | nil _ => O | cons x t => match p x with | true => S (count p t) | false => count p t end end.
Theorem select_cons_app : forall (A : Set) (b : bool) (x : A) (l m : list A), ((select_cons b x (app l m)) = (app (select_cons b x l) m)) := fun A b x l m => match b as q return ((select_cons q x (app l m)) = (app (select_cons q x l) m)) with | true => eq_refl (cons x (app l m)) | false => eq_refl (app l m) end.
Theorem filter_app : forall (A : Set) (p : A -> bool) (l m : list A), ((filter p (app l m)) = (app (filter p l) (filter p m))) := fun A p => fix go (l m : list A) {struct l} : ((filter p (app l m)) = (app (filter p l) (filter p m))) := match l as xs return ((filter p (app xs m)) = (app (filter p xs) (filter p m))) with | nil _ => eq_refl (filter p m) | cons x t => eq_trans (select_cons (p x) x (filter p (app t m))) (select_cons (p x) x (app (filter p t) (filter p m))) (app (select_cons (p x) x (filter p t)) (filter p m)) (f_equal (select_cons (p x) x) (filter p (app t m)) (app (filter p t) (filter p m)) (go t m)) (select_cons_app A (p x) x (filter p t) (filter p m)) end.
Theorem filter_true : forall (A : Set) (l : list A), ((filter (fun x => true) l) = l) := fun A => fix go (l : list A) {struct l} : ((filter (fun x => true) l) = l) := match l as xs return ((filter (fun x => true) xs) = xs) with | nil _ => eq_refl (nil A) | cons x t => f_equal (cons x) (filter (fun y => true) t) t (go t) end.
Theorem filter_false : forall (A : Set) (l : list A), ((filter (fun x => false) l) = (nil A)) := fun A => fix go (l : list A) {struct l} : ((filter (fun x => false) l) = (nil A)) := match l as xs return ((filter (fun x => false) xs) = (nil A)) with | nil _ => eq_refl (nil A) | cons x t => go t end.
Theorem select_cons_length : forall (A : Set) (b : bool) (x : A) (l : list A), ((length (select_cons b x l)) = (match b return nat with | true => S (length l) | false => length l end)) := fun A b x l => match b as q return ((length (select_cons q x l)) = (match q return nat with | true => S (length l) | false => length l end)) with | true => eq_refl (S (length l)) | false => eq_refl (length l) end.
Theorem count_filter_length : forall (A : Set) (p : A -> bool) (l : list A), ((count p l) = (length (filter p l))) := fun A p => fix go (l : list A) {struct l} : ((count p l) = (length (filter p l))) := match l as xs return ((count p xs) = (length (filter p xs))) with | nil _ => eq_refl O | cons x t => match p x as b return ((match b return nat with | true => S (count p t) | false => count p t end) = (length (select_cons b x (filter p t)))) with | true => f_equal S (count p t) (length (filter p t)) (go t) | false => go t end end.
Theorem partition_left : forall (A : Set) (p : A -> bool) (l : list A), ((fst (list A) (list A) (partition p l)) = (filter p l)) := fun A p l => eq_refl (filter p l).
Theorem partition_right : forall (A : Set) (p : A -> bool) (l : list A), ((snd (list A) (list A) (partition p l)) = (filter (fun x => negb (p x)) l)) := fun A p l => eq_refl (filter (fun x => negb (p x)) l).
Theorem update_length : forall (A : Set) (l : list A) (n : nat) (x : A), ((length (update n x l)) = (length l)) := fun A => fix go (l : list A) {struct l} : forall (n : nat) (x : A), ((length (update n x l)) = (length l)) := match l as xs return (forall (n : nat) (x : A), ((length (update n x xs)) = (length xs))) with | nil _ => fun n x => eq_refl O | cons y t => fun n x => match n as k return ((length (update k x (cons y t))) = (S (length t))) with | O => eq_refl (S (length t)) | S k => f_equal S (length (update k x t)) (length t) (go t k x) end end.
Theorem update_head : forall (A : Set) (x y : A) (l : list A), ((update O x (cons y l)) = (cons x l)) := fun A x y l => eq_refl (cons x l).
Theorem update_twice : forall (A : Set) (l : list A) (n : nat) (x y : A), ((update n x (update n y l)) = (update n x l)) := fun A => fix go (l : list A) {struct l} : forall (n : nat) (x y : A), ((update n x (update n y l)) = (update n x l)) := match l as xs return (forall (n : nat) (x y : A), ((update n x (update n y xs)) = (update n x xs))) with | nil _ => fun n x y => eq_refl (nil A) | cons z t => fun n x y => match n as k return ((update k x (update k y (cons z t))) = (update k x (cons z t))) with | O => eq_refl (cons x t) | S k => f_equal (cons z) (update k x (update k y t)) (update k x t) (go t k x y) end end.
Theorem nth_error_map : forall (A B : Set) (f : A -> B) (l : list A) (n : nat), ((nth_error (map f l) n) = (option_map A B f (nth_error l n))) := fun A B f => fix go (l : list A) {struct l} : forall n : nat, ((nth_error (map f l) n) = (option_map A B f (nth_error l n))) := match l as xs return (forall n : nat, ((nth_error (map f xs) n) = (option_map A B f (nth_error xs n)))) with | nil _ => fun n => eq_refl (None B) | cons x t => fun n => match n as k return ((nth_error (map f (cons x t)) k) = (option_map A B f (nth_error (cons x t) k))) with | O => eq_refl (Some B (f x)) | S k => go t k end end.
Theorem update_map : forall (A B : Set) (f : A -> B) (l : list A) (n : nat) (x : A), ((map f (update n x l)) = (update n (f x) (map f l))) := fun A B f => fix go (l : list A) {struct l} : forall (n : nat) (x : A), ((map f (update n x l)) = (update n (f x) (map f l))) := match l as xs return (forall (n : nat) (x : A), ((map f (update n x xs)) = (update n (f x) (map f xs)))) with | nil _ => fun n x => eq_refl (nil B) | cons y t => fun n x => match n as k return ((map f (update k x (cons y t))) = (update k (f x) (map f (cons y t)))) with | O => eq_refl (cons (f x) (map f t)) | S k => f_equal (cons (f y)) (map f (update k x t)) (update k (f x) (map f t)) (go t k x) end end.
Theorem zip_with_length : forall (A B C : Set) (f : A -> B -> C) (l : list A) (m : list B), ((length (zip_with f l m)) = (min (length l) (length m))) := fun A B C f => fix go (l : list A) {struct l} : forall m : list B, ((length (zip_with f l m)) = (min (length l) (length m))) := match l as xs return (forall m : list B, ((length (zip_with f xs m)) = (min (length xs) (length m)))) with | nil _ => fun m => eq_refl O | cons x t => fun m => match m as ys return ((length (zip_with f (cons x t) ys)) = (min (S (length t)) (length ys))) with | nil _ => eq_refl O | cons y u => f_equal S (length (zip_with f t u)) (min (length t) (length u)) (go t u) end end.
Theorem zip_with_map : forall (A B C D : Set) (f : A -> B -> C) (g : C -> D) (l : list A) (m : list B), ((map g (zip_with f l m)) = (zip_with (fun x y => g (f x y)) l m)) := fun A B C D f g => fix go (l : list A) {struct l} : forall m : list B, ((map g (zip_with f l m)) = (zip_with (fun x y => g (f x y)) l m)) := match l as xs return (forall m : list B, ((map g (zip_with f xs m)) = (zip_with (fun x y => g (f x y)) xs m))) with | nil _ => fun m => eq_refl (nil D) | cons x t => fun m => match m as ys return ((map g (zip_with f (cons x t) ys)) = (zip_with (fun a b => g (f a b)) (cons x t) ys)) with | nil _ => eq_refl (nil D) | cons y u => f_equal (cons (g (f x y))) (map g (zip_with f t u)) (zip_with (fun a b => g (f a b)) t u) (go t u) end end.
Theorem zip_with_combine : forall (A B : Set) (l : list A) (m : list B), ((zip_with (pair A B) l m) = (combine l m)) := fun A B => fix go (l : list A) {struct l} : forall m : list B, ((zip_with (pair A B) l m) = (combine l m)) := match l as xs return (forall m : list B, ((zip_with (pair A B) xs m) = (combine xs m))) with | nil _ => fun m => eq_refl (nil (prod A B)) | cons x t => fun m => match m as ys return ((zip_with (pair A B) (cons x t) ys) = (combine (cons x t) ys)) with | nil _ => eq_refl (nil (prod A B)) | cons y u => f_equal (cons (pair A B x y)) (zip_with (pair A B) t u) (combine t u) (go t u) end end.
Theorem rev_append_correct : forall (A : Set) (l m : list A), ((rev_append l m) = (app (rev l) m)) := fun A => fix go (l : list A) {struct l} : forall m : list A, ((rev_append l m) = (app (rev l) m)) := match l as xs return (forall m : list A, ((rev_append xs m) = (app (rev xs) m))) with | nil _ => fun m => eq_refl m | cons x t => fun m => eq_trans (rev_append t (cons x m)) (app (rev t) (cons x m)) (app (app (rev t) (singleton x)) m) (go t (cons x m)) (eq_sym (app (app (rev t) (singleton x)) m) (app (rev t) (cons x m)) (app_assoc A (rev t) (singleton x) m)) end.
Theorem rev_fast_correct : forall (A : Set) (l : list A), ((rev_fast l) = (rev l)) := fun A l => eq_trans (rev_append l (nil A)) (app (rev l) (nil A)) (rev l) (rev_append_correct A l (nil A)) (app_nil_right A (rev l)).
Theorem rev_fast_involutive : forall (A : Set) (l : list A), ((rev_fast (rev_fast l)) = l) := fun A l => eq_trans (rev_fast (rev_fast l)) (rev (rev_fast l)) l (rev_fast_correct A (rev_fast l)) (eq_trans (rev (rev_fast l)) (rev (rev l)) l (f_equal (rev) (rev_fast l) (rev l) (rev_fast_correct A l)) (rev_involutive A l)).
Theorem rev_fast_length : forall (A : Set) (l : list A), ((length (rev_fast l)) = (length l)) := fun A l => eq_trans (length (rev_fast l)) (length (rev l)) (length l) (f_equal (length) (rev_fast l) (rev l) (rev_fast_correct A l)) (length_rev A l).
Theorem partition_count : forall (A : Set) (p : A -> bool) (l : list A), ((add (count p l) (count (fun x => negb (p x)) l)) = (length l)) := fun A p => fix go (l : list A) {struct l} : ((add (count p l) (count (fun x => negb (p x)) l)) = (length l)) := match l as xs return ((add (count p xs) (count (fun x => negb (p x)) xs)) = (length xs)) with | nil _ => eq_refl O | cons x t => match p x as b return ((add (match b return nat with | true => S (count p t) | false => count p t end) (match negb b return nat with | true => S (count (fun y => negb (p y)) t) | false => count (fun y => negb (p y)) t end)) = (S (length t))) with | true => f_equal S (add (count p t) (count (fun y => negb (p y)) t)) (length t) (go t) | false => eq_trans (add (count p t) (S (count (fun y => negb (p y)) t))) (S (add (count p t) (count (fun y => negb (p y)) t))) (S (length t)) (add_n_Sm (count p t) (count (fun y => negb (p y)) t)) (f_equal S (add (count p t) (count (fun y => negb (p y)) t)) (length t) (go t)) end end.
Theorem partition_length : forall (A : Set) (p : A -> bool) (l : list A), ((add (length (fst (list A) (list A) (partition p l))) (length (snd (list A) (list A) (partition p l)))) = (length l)) := fun A p l => eq_trans (add (length (filter p l)) (length (filter (fun x => negb (p x)) l))) (add (count p l) (count (fun x => negb (p x)) l)) (length l) (eq_trans (add (length (filter p l)) (length (filter (fun x => negb (p x)) l))) (add (count p l) (length (filter (fun x => negb (p x)) l))) (add (count p l) (count (fun x => negb (p x)) l)) (f_equal (fun n => add n (length (filter (fun x => negb (p x)) l))) (length (filter p l)) (count p l) (eq_sym (count p l) (length (filter p l)) (count_filter_length A p l))) (f_equal (add (count p l)) (length (filter (fun x => negb (p x)) l)) (count (fun x => negb (p x)) l) (eq_sym (count (fun x => negb (p x)) l) (length (filter (fun x => negb (p x)) l)) (count_filter_length A (fun x => negb (p x)) l)))) (partition_count A p l).
Theorem nth_error_repeat : forall (A : Set) (x : A) (n k : nat), ((nth_error (repeat x n) k) = (match ltb k n return option A with | true => Some A x | false => None A end)) := fun A x => fix go (n : nat) {struct n} : forall k : nat, ((nth_error (repeat x n) k) = (match ltb k n return option A with | true => Some A x | false => None A end)) := match n as m return (forall k : nat, ((nth_error (repeat x m) k) = (match ltb k m return option A with | true => Some A x | false => None A end))) with | O => fun k => eq_refl (None A) | S m => fun k => match k as q return ((nth_error (repeat x (S m)) q) = (match ltb q (S m) return option A with | true => Some A x | false => None A end)) with | O => eq_refl (Some A x) | S q => go m q end end.
Theorem nth_update_same : forall (A : Set) (l : list A) (n : nat) (x : A), ((nth_error (update n x l) n) = (match nth_error l n return option A with | None _ => None A | Some _ y => Some A x end)) := fun A => fix go (l : list A) {struct l} : forall (n : nat) (x : A), ((nth_error (update n x l) n) = (match nth_error l n return option A with | None _ => None A | Some _ y => Some A x end)) := match l as xs return (forall (n : nat) (x : A), ((nth_error (update n x xs) n) = (match nth_error xs n return option A with | None _ => None A | Some _ y => Some A x end))) with | nil _ => fun n x => eq_refl (None A) | cons y t => fun n x => match n as k return ((nth_error (update k x (cons y t)) k) = (match nth_error (cons y t) k return option A with | None _ => None A | Some _ z => Some A x end)) with | O => eq_refl (Some A x) | S k => go t k x end end.
Theorem nth_error_app_right : forall (A : Set) (l m : list A) (n : nat), ((nth_error (app l m) (add (length l) n)) = (nth_error m n)) := fun A => fix go (l m : list A) (n : nat) {struct l} : ((nth_error (app l m) (add (length l) n)) = (nth_error m n)) := match l as xs return ((nth_error (app xs m) (add (length xs) n)) = (nth_error m n)) with | nil _ => eq_refl (nth_error m n) | cons x t => go t m n end.
Theorem find_filter : forall (A : Set) (p : A -> bool) (l : list A), ((find p l) = (head_option (filter p l))) := fun A p => fix go (l : list A) {struct l} : ((find p l) = (head_option (filter p l))) := match l as xs return ((find p xs) = (head_option (filter p xs))) with | nil _ => eq_refl (None A) | cons x t => match p x as b return ((match b return option A with | true => Some A x | false => find p t end) = (head_option (select_cons b x (filter p t)))) with | true => eq_refl (Some A x) | false => go t end end.
Theorem find_true : forall (A : Set) (l : list A), ((find (fun x => true) l) = (head_option l)) := fun A l => match l as xs return ((find (fun x => true) xs) = (head_option xs)) with | nil _ => eq_refl (None A) | cons x t => eq_refl (Some A x) end.
Theorem find_false : forall (A : Set) (l : list A), ((find (fun x => false) l) = (None A)) := fun A => fix go (l : list A) {struct l} : ((find (fun x => false) l) = (None A)) := match l as xs return ((find (fun x => false) xs) = (None A)) with | nil _ => eq_refl (None A) | cons x t => go t end.
Theorem filter_Forall : forall (A : Set) (p : A -> bool) (l : list A), Forall (fun x => ((p x) = true)) (filter p l) := fun A p => fix go (l : list A) {struct l} : Forall (fun x => ((p x) = true)) (filter p l) := match l as xs return Forall (fun x => ((p x) = true)) (filter p xs) with | nil _ => I | cons x t => (match p x as b return (((p x) = b) -> Forall (fun y => ((p y) = true)) (select_cons b x (filter p t))) with | true => fun e => conj (((p x) = true)) (Forall (fun y => ((p y) = true)) (filter p t)) e (go t) | false => fun e => go t end) (eq_refl (p x)) end.
Theorem filter_all_true : forall (A : Set) (p : A -> bool) (l : list A), Forall (fun x => ((p x) = true)) l -> ((filter p l) = l) := fun A p => fix go (l : list A) {struct l} : Forall (fun x => ((p x) = true)) l -> ((filter p l) = l) := match l as xs return (Forall (fun x => ((p x) = true)) xs -> ((filter p xs) = xs)) with | nil _ => fun h => eq_refl (nil A) | cons x t => fun h => eq_transport bool (fun b => ((select_cons b x (filter p t)) = (cons x t))) true (p x) (eq_sym (p x) true (Forall_head A (fun y => ((p y) = true)) x t h)) (f_equal (cons x) (filter p t) t (go t (Forall_tail A (fun y => ((p y) = true)) x t h))) end.
Theorem filter_idempotent : forall (A : Set) (p : A -> bool) (l : list A), ((filter p (filter p l)) = (filter p l)) := fun A p l => filter_all_true A p (filter p l) (filter_Forall A p l).
Theorem head_option_Forall : forall (A : Set) (P : A -> Prop) (l : list A) (x : A), Forall P l -> ((head_option l) = (Some A x)) -> P x := fun A P l => match l as xs return (forall x : A, Forall P xs -> ((head_option xs) = (Some A x)) -> P x) with | nil _ => fun x h e => False_rect (P x) (None_not_Some A x e) | cons y t => fun x h e => eq_transport A P y x (Some_injective A y x e) (Forall_head A P y t h) end.
Theorem head_option_In : forall (A : Set) (l : list A) (x : A), ((head_option l) = (Some A x)) -> In x l := fun A l => match l as xs return (forall x : A, ((head_option xs) = (Some A x)) -> In x xs) with | nil _ => fun x e => None_not_Some A x e | cons y t => fun x e => or_introl (x = y) (In x t) (eq_sym y x (Some_injective A y x e)) end.
Theorem head_none_empty : forall (A : Set) (l : list A), ((head_option l) = (None A)) -> (l = (nil A)) := fun A l => match l as xs return (((head_option xs) = (None A)) -> (xs = (nil A))) with | nil _ => fun e => eq_refl (nil A) | cons x t => fun e => False_rect (((cons x t) = (nil A))) (None_not_Some A x (eq_sym (Some A x) (None A) e)) end.
Theorem find_satisfies : forall (A : Set) (p : A -> bool) (l : list A) (x : A), ((find p l) = (Some A x)) -> ((p x) = true) := fun A p l x e => head_option_Forall A (fun y => ((p y) = true)) (filter p l) x (filter_Forall A p l) (eq_trans (head_option (filter p l)) (find p l) (Some A x) (eq_sym (find p l) (head_option (filter p l)) (find_filter A p l)) e).
Theorem find_in_filtered : forall (A : Set) (p : A -> bool) (l : list A) (x : A), ((find p l) = (Some A x)) -> In x (filter p l) := fun A p l x e => head_option_In A (filter p l) x (eq_trans (head_option (filter p l)) (find p l) (Some A x) (eq_sym (find p l) (head_option (filter p l)) (find_filter A p l)) e).
Theorem find_none_filter_empty : forall (A : Set) (p : A -> bool) (l : list A), ((find p l) = (None A)) -> ((filter p l) = (nil A)) := fun A p l e => head_none_empty A (filter p l) (eq_trans (head_option (filter p l)) (find p l) (None A) (eq_sym (find p l) (head_option (filter p l)) (find_filter A p l)) e).
Theorem filter_empty_find_none : forall (A : Set) (p : A -> bool) (l : list A), ((filter p l) = (nil A)) -> ((find p l) = (None A)) := fun A p l e => eq_trans (find p l) (head_option (filter p l)) (None A) (find_filter A p l) (f_equal (head_option) (filter p l) (nil A) e).
Theorem nth_error_In : forall (A : Set) (l : list A) (n : nat) (x : A), ((nth_error l n) = (Some A x)) -> In x l := fun A => fix go (l : list A) {struct l} : forall (n : nat) (x : A), ((nth_error l n) = (Some A x)) -> In x l := match l as xs return (forall (n : nat) (x : A), ((nth_error xs n) = (Some A x)) -> In x xs) with | nil _ => fun n x e => None_not_Some A x e | cons y t => fun n x => match n as k return (((nth_error (cons y t) k) = (Some A x)) -> In x (cons y t)) with | O => fun e => or_introl (x = y) (In x t) (eq_sym y x (Some_injective A y x e)) | S k => fun e => In_tail A x y t (go t k x e) end end.
Theorem update_nth_identity : forall (A : Set) (l : list A) (n : nat) (x : A), ((nth_error l n) = (Some A x)) -> ((update n x l) = l) := fun A => fix go (l : list A) {struct l} : forall (n : nat) (x : A), ((nth_error l n) = (Some A x)) -> ((update n x l) = l) := match l as xs return (forall (n : nat) (x : A), ((nth_error xs n) = (Some A x)) -> ((update n x xs) = xs)) with | nil _ => fun n x e => eq_refl (nil A) | cons y t => fun n x => match n as k return (((nth_error (cons y t) k) = (Some A x)) -> ((update k x (cons y t)) = (cons y t))) with | O => fun e => f_equal (fun z => cons z t) x y (eq_sym y x (Some_injective A y x e)) | S k => fun e => f_equal (cons y) (update k x t) t (go t k x e) end end.
Theorem map_take : forall (A B : Set) (f : A -> B) (n : nat) (l : list A), ((map f (take n l)) = (take n (map f l))) := fun A B f => fix go (n : nat) {struct n} : forall l : list A, ((map f (take n l)) = (take n (map f l))) := match n as k return (forall l : list A, ((map f (take k l)) = (take k (map f l)))) with | O => fun l => eq_refl (nil B) | S k => fun l => match l as xs return ((map f (take (S k) xs)) = (take (S k) (map f xs))) with | nil _ => eq_refl (nil B) | cons x t => f_equal (cons (f x)) (map f (take k t)) (take k (map f t)) (go k t) end end.
Theorem map_drop : forall (A B : Set) (f : A -> B) (n : nat) (l : list A), ((map f (drop n l)) = (drop n (map f l))) := fun A B f => fix go (n : nat) {struct n} : forall l : list A, ((map f (drop n l)) = (drop n (map f l))) := match n as k return (forall l : list A, ((map f (drop k l)) = (drop k (map f l)))) with | O => fun l => eq_refl (map f l) | S k => fun l => match l as xs return ((map f (drop (S k) xs)) = (drop (S k) (map f xs))) with | nil _ => eq_refl (nil B) | cons x t => go k t end end.
Theorem length_take : forall (A : Set) (n : nat) (l : list A), ((length (take n l)) = (min n (length l))) := fun A => fix go (n : nat) {struct n} : forall l : list A, ((length (take n l)) = (min n (length l))) := match n as k return (forall l : list A, ((length (take k l)) = (min k (length l)))) with | O => fun l => eq_refl O | S k => fun l => match l as xs return ((length (take (S k) xs)) = (min (S k) (length xs))) with | nil _ => eq_refl O | cons x t => f_equal S (length (take k t)) (min k (length t)) (go k t) end end.
Theorem length_drop : forall (A : Set) (n : nat) (l : list A), ((length (drop n l)) = (sub (length l) n)) := fun A => fix go (n : nat) {struct n} : forall l : list A, ((length (drop n l)) = (sub (length l) n)) := match n as k return (forall l : list A, ((length (drop k l)) = (sub (length l) k))) with | O => fun l => eq_refl (length l) | S k => fun l => match l as xs return ((length (drop (S k) xs)) = (sub (length xs) (S k))) with | nil _ => eq_refl O | cons x t => go k t end end.
Theorem take_nil : forall (A : Set) (n : nat), ((take n (nil A)) = (nil A)) := fun A n => match n as k return ((take k (nil A)) = (nil A)) with | O => eq_refl (nil A) | S k => eq_refl (nil A) end.
Theorem drop_nil : forall (A : Set) (n : nat), ((drop n (nil A)) = (nil A)) := fun A n => match n as k return ((drop k (nil A)) = (nil A)) with | O => eq_refl (nil A) | S k => eq_refl (nil A) end.
Theorem drop_drop : forall (A : Set) (n m : nat) (l : list A), ((drop m (drop n l)) = (drop (add n m) l)) := fun A => fix go (n m : nat) {struct n} : forall l : list A, ((drop m (drop n l)) = (drop (add n m) l)) := match n as k return (forall l : list A, ((drop m (drop k l)) = (drop (add k m) l))) with | O => fun l => eq_refl (drop m l) | S k => fun l => match l as xs return ((drop m (drop (S k) xs)) = (drop (add (S k) m) xs)) with | nil _ => drop_nil A m | cons x t => go k m t end end.
Theorem zip_with_map_left : forall (A B C D : Set) (f : B -> C -> D) (g : A -> B) (l : list A) (m : list C), ((zip_with f (map g l) m) = (zip_with (fun x y => f (g x) y) l m)) := fun A B C D f g => fix go (l : list A) {struct l} : forall m : list C, ((zip_with f (map g l) m) = (zip_with (fun x y => f (g x) y) l m)) := match l as xs return (forall m : list C, ((zip_with f (map g xs) m) = (zip_with (fun x y => f (g x) y) xs m))) with | nil _ => fun m => eq_refl (nil D) | cons x t => fun m => match m as ys return ((zip_with f (map g (cons x t)) ys) = (zip_with (fun a b => f (g a) b) (cons x t) ys)) with | nil _ => eq_refl (nil D) | cons y u => f_equal (cons (f (g x) y)) (zip_with f (map g t) u) (zip_with (fun a b => f (g a) b) t u) (go t u) end end.
Theorem zip_with_map_right : forall (A B C D : Set) (f : A -> C -> D) (g : B -> C) (l : list A) (m : list B), ((zip_with f l (map g m)) = (zip_with (fun x y => f x (g y)) l m)) := fun A B C D f g => fix go (l : list A) {struct l} : forall m : list B, ((zip_with f l (map g m)) = (zip_with (fun x y => f x (g y)) l m)) := match l as xs return (forall m : list B, ((zip_with f xs (map g m)) = (zip_with (fun x y => f x (g y)) xs m))) with | nil _ => fun m => eq_refl (nil D) | cons x t => fun m => match m as ys return ((zip_with f (cons x t) (map g ys)) = (zip_with (fun a b => f a (g b)) (cons x t) ys)) with | nil _ => eq_refl (nil D) | cons y u => f_equal (cons (f x (g y))) (zip_with f t (map g u)) (zip_with (fun a b => f a (g b)) t u) (go t u) end end.
Theorem combine_length : forall (A B : Set) (l : list A) (m : list B), ((length (combine l m)) = (min (length l) (length m))) := fun A B l m => eq_trans (length (combine l m)) (length (zip_with (pair A B) l m)) (min (length l) (length m)) (f_equal (length) (combine l m) (zip_with (pair A B) l m) (eq_sym (zip_with (pair A B) l m) (combine l m) (zip_with_combine A B l m))) (zip_with_length A B (prod A B) (pair A B) l m).
Theorem unzip_left_length : forall (A B : Set) (l : list (prod A B)), ((length (fst (list A) (list B) (unzip l))) = (length l)) := fun A B l => length_map (prod A B) A (fst A B) l.
Theorem unzip_right_length : forall (A B : Set) (l : list (prod A B)), ((length (snd (list A) (list B) (unzip l))) = (length l)) := fun A B l => length_map (prod A B) B (snd A B) l.

(* Filtering preserves membership, and retains every matching member. *)
Theorem filter_In : forall (A : Set) (p : A -> bool) (l : list A) (x : A), In x (filter p l) -> In x l :=
    fun A p => fix go (l : list A) {struct l} : forall x : A, In x (filter p l) -> In x l :=
        match l as xs return forall x : A, In x (filter p xs) -> In x xs with
        | nil _ => fun x h => h
        | cons y t => fun x => match p y as b return In x (select_cons b y (filter p t)) -> In x (cons y t) with
            | true => fun h => or_map (x = y) (In x (filter p t)) (x = y) (In x t)
                (fun e => e) (go t x) h
            | false => fun h => In_tail A x y t (go t x h)
            end
        end.
Theorem filter_In_intro : forall (A : Set) (p : A -> bool) (l : list A) (x : A), In x l -> ((p x) = true) -> In x (filter p l) :=
    fun A p => fix go (l : list A) {struct l} : forall x : A, In x l -> ((p x) = true) -> In x (filter p l) :=
        match l as xs return forall x : A, In x xs -> ((p x) = true) -> In x (filter p xs) with
        | nil _ => fun x h e => h
        | cons y t => fun x h e => or_elim (x = y) (In x t) (In x (filter p (cons y t)))
            (fun same => eq_transport bool (fun b => In x (select_cons b y (filter p t))) true (p y)
                (eq_sym (p y) true (eq_trans (p y) (p x) true (f_equal p y x (eq_sym x y same)) e))
                (or_introl (x = y) (In x (filter p t)) same))
            (fun tail => match p y as b return In x (select_cons b y (filter p t)) with
                | true => In_tail A x y (filter p t) (go t x tail e)
                | false => go t x tail e
                end) h
        end.
Theorem partition_covers : forall (A : Set) (p : A -> bool) (l : list A) (x : A), In x l ->
    or (In x (fst (list A) (list A) (partition p l))) (In x (snd (list A) (list A) (partition p l))) :=
    fun A p l x h => (match p x as b return ((p x) = b) ->
        or (In x (filter p l)) (In x (filter (fun y => negb (p y)) l)) with
        | true => fun e => or_introl (In x (filter p l)) (In x (filter (fun y => negb (p y)) l)) (filter_In_intro A p l x h e)
        | false => fun e => or_intror (In x (filter p l)) (In x (filter (fun y => negb (p y)) l))
            (filter_In_intro A (fun y => negb (p y)) l x h (f_equal negb (p x) false e))
        end) (eq_refl (p x)).

(* Appending, the positions that an update leaves, and the permutations of a partition and of the empty list. *)
Theorem count_app : forall (A : Set) (p : A -> bool) (l m : list A), ((count p (app l m)) = (add (count p l) (count p m))) :=
    fun A p => fix go (l m : list A) {struct l} : ((count p (app l m)) = (add (count p l) (count p m))) :=
        match l as xs return ((count p (app xs m)) = (add (count p xs) (count p m))) with
        | nil _ => eq_refl (count p m)
        | cons x t => match p x as b return ((match b return nat with | true => S (count p (app t m)) | false => count p (app t m) end) =
                (add (match b return nat with | true => S (count p t) | false => count p t end) (count p m))) with
            | true => f_equal S (count p (app t m)) (add (count p t) (count p m)) (go t m)
            | false => go t m
            end
        end.
Theorem find_app : forall (A : Set) (p : A -> bool) (l m : list A), ((find p (app l m)) = (option_or A (find p l) (find p m))) :=
    fun A p => fix go (l m : list A) {struct l} : ((find p (app l m)) = (option_or A (find p l) (find p m))) :=
        match l as xs return ((find p (app xs m)) = (option_or A (find p xs) (find p m))) with
        | nil _ => eq_refl (find p m)
        | cons x t => match p x as b return ((match b return option A with | true => Some A x | false => find p (app t m) end) =
                (option_or A (match b return option A with | true => Some A x | false => find p t end) (find p m))) with
            | true => eq_refl (Some A x)
            | false => go t m
            end
        end.
Theorem nth_update_other : forall (A : Set) (l : list A) (n m : nat) (x : A), not (n = m) -> ((nth_error (update n x l) m) = (nth_error l m)) :=
    fun A => fix go (l : list A) {struct l} : forall (n m : nat) (x : A), not (n = m) -> ((nth_error (update n x l) m) = (nth_error l m)) :=
        match l as xs return (forall (n m : nat) (x : A), not (n = m) -> ((nth_error (update n x xs) m) = (nth_error xs m))) with
        | nil _ => fun n m x h => eq_refl (None A)
        | cons y t => fun n m x => match n as k return (not (k = m) -> ((nth_error (update k x (cons y t)) m) = (nth_error (cons y t) m))) with
            | O => match m as j return (not (O = j) -> ((nth_error (update O x (cons y t)) j) = (nth_error (cons y t) j))) with
                | O => fun h => False_rect ((Some A x) = (Some A y)) (h (eq_refl O))
                | S j => fun h => eq_refl (nth_error t j)
                end
            | S k => match m as j return (not ((S k) = j) -> ((nth_error (update (S k) x (cons y t)) j) = (nth_error (cons y t) j))) with
                | O => fun h => eq_refl (Some A y)
                | S j => fun h => go t k j x (fun e => h (f_equal S k j e))
                end
            end
        end.
Theorem partition_permutation : forall (A : Set) (p : A -> bool) (l : list A),
    Permutation l (app (fst (list A) (list A) (partition p l)) (snd (list A) (list A) (partition p l))) :=
    fun A p => fix go (l : list A) {struct l} : Permutation l (app (filter p l) (filter (fun x => negb (p x)) l)) :=
        match l as xs return Permutation xs (app (filter p xs) (filter (fun x => negb (p x)) xs)) with
        | nil _ => @perm_nil A
        | cons x t => match p x as b return Permutation (cons x t)
                (app (select_cons b x (filter p t)) (select_cons (negb b) x (filter (fun y => negb (p y)) t))) with
            | true => perm_skip x t (app (filter p t) (filter (fun y => negb (p y)) t)) (go t)
            | false => perm_trans (cons x t) (cons x (app (filter p t) (filter (fun y => negb (p y)) t)))
                    (app (filter p t) (cons x (filter (fun y => negb (p y)) t)))
                (perm_skip x t (app (filter p t) (filter (fun y => negb (p y)) t)) (go t))
                (Permutation_middle A x (filter p t) (filter (fun y => negb (p y)) t))
            end
        end.
Theorem Permutation_nil : forall (A : Set) (l : list A), Permutation (nil A) l -> (l = (nil A)) :=
    fun A l => match l as xs return Permutation (nil A) xs -> (xs = (nil A)) with
        | nil _ => fun h => eq_refl (nil A)
        | cons x t => fun h => False_rect ((cons x t) = (nil A)) (O_not_S (length t) (Permutation_length A (nil A) (cons x t) h))
        end.
