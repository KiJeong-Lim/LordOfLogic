(* Extrinsic, Church-style STLC with unit and call-by-value reduction.
   Variables are de Bruijn indices; simultaneous substitution lifts below binders. *)
Import lol.theories.Logic.
Import lol.theories.Nat.
Inductive sty : Set := | st_unit : sty | st_arrow : sty -> sty -> sty.
Inductive sterm : Set := | st_var : nat -> sterm | st_tt : sterm | st_lam : sty -> sterm -> sterm | st_app : sterm -> sterm -> sterm.
Definition sctx : Set := nat -> option sty.
Definition sempty : sctx := fun n => None sty.
Definition sextend (A : sty) (G : sctx) : sctx := fun n => match n return option sty with | O => Some sty A | S k => G k end.
Definition slift (r : nat -> nat) : nat -> nat := fun n => match n return nat with | O => O | S k => S (r k) end.
Fixpoint srename (r : nat -> nat) (t : sterm) {struct t} : sterm := match t return sterm with | st_var n => st_var (r n) | st_tt => st_tt | st_lam A b => st_lam A (srename (slift r) b) | st_app f x => st_app (srename r f) (srename r x) end.
Definition slift_sub (s : nat -> sterm) : nat -> sterm := fun n => match n return sterm with | O => st_var O | S k => srename S (s k) end.
Fixpoint ssubst (s : nat -> sterm) (t : sterm) {struct t} : sterm := match t return sterm with | st_var n => s n | st_tt => st_tt | st_lam A b => st_lam A (ssubst (slift_sub s) b) | st_app f x => st_app (ssubst s f) (ssubst s x) end.
Definition sreplace (v : sterm) : nat -> sterm := fun n => match n return sterm with | O => v | S k => st_var k end.
Definition sbeta (b v : sterm) : sterm := ssubst (sreplace v) b.
Inductive styping : sctx -> sterm -> sty -> Prop := | st_ty_var : forall (G : sctx) (n : nat) (A : sty), ((G n) = (Some sty A)) -> styping G (st_var n) A | st_ty_tt : forall G : sctx, styping G st_tt st_unit | st_ty_lam : forall (G : sctx) (A B : sty) (b : sterm), styping (sextend A G) b B -> styping G (st_lam A b) (st_arrow A B) | st_ty_app : forall (G : sctx) (A B : sty) (f x : sterm), styping G f (st_arrow A B) -> styping G x A -> styping G (st_app f x) B.
Definition srenaming (G D : sctx) (r : nat -> nat) : Prop := forall (n : nat) (A : sty), ((G n) = (Some sty A)) -> ((D (r n)) = (Some sty A)).
Definition slift_typed (G D : sctx) (r : nat -> nat) (h : srenaming G D r) (B : sty) : srenaming (sextend B G) (sextend B D) (slift r) := fun n => match n as k return (forall A : sty, (((sextend B G) k) = (Some sty A)) -> (((sextend B D) (slift r k)) = (Some sty A))) with | O => fun A e => e | S k => h k end.
Definition srename_typing : forall (G : sctx) (t : sterm) (A : sty), styping G t A -> forall (D : sctx) (r : nat -> nat), srenaming G D r -> styping D (srename r t) A := fix go (G : sctx) (t : sterm) (A : sty) (h : styping G t A) {struct h} : forall (D : sctx) (r : nat -> nat), srenaming G D r -> styping D (srename r t) A := match h in styping C e T return (forall (D : sctx) (r : nat -> nat), srenaming C D r -> styping D (srename r e) T) with | st_ty_var C n T e => fun D r hr => st_ty_var D (r n) T (hr n T e) | st_ty_tt C => fun D r hr => st_ty_tt D | st_ty_lam C T U b hb => fun D r hr => st_ty_lam D T U (srename (slift r) b) (go (sextend T C) b U hb (sextend T D) (slift r) (slift_typed C D r hr T)) | st_ty_app C T U f x hf hx => fun D r hr => st_ty_app D T U (srename r f) (srename r x) (go C f (st_arrow T U) hf D r hr) (go C x T hx D r hr) end.
Definition sweaken : forall (G : sctx) (t : sterm) (A B : sty), styping G t A -> styping (sextend B G) (srename S t) A := fun G t A B h => srename_typing G t A h (sextend B G) S (fun n T e => e).
Definition ssubstitution (G D : sctx) (s : nat -> sterm) : Prop := forall (n : nat) (A : sty), ((G n) = (Some sty A)) -> styping D (s n) A.
Definition slift_sub_typed (G D : sctx) (s : nat -> sterm) (h : ssubstitution G D s) (B : sty) : ssubstitution (sextend B G) (sextend B D) (slift_sub s) := fun n => match n as k return (forall A : sty, (((sextend B G) k) = (Some sty A)) -> styping (sextend B D) (slift_sub s k) A) with | O => fun A e => st_ty_var (sextend B D) O A e | S k => fun A e => sweaken D (s k) A B (h k A e) end.
Definition ssubst_typing : forall (G : sctx) (t : sterm) (A : sty), styping G t A -> forall (D : sctx) (s : nat -> sterm), ssubstitution G D s -> styping D (ssubst s t) A := fix go (G : sctx) (t : sterm) (A : sty) (h : styping G t A) {struct h} : forall (D : sctx) (s : nat -> sterm), ssubstitution G D s -> styping D (ssubst s t) A := match h in styping C e T return (forall (D : sctx) (s : nat -> sterm), ssubstitution C D s -> styping D (ssubst s e) T) with | st_ty_var C n T e => fun D s hs => hs n T e | st_ty_tt C => fun D s hs => st_ty_tt D | st_ty_lam C T U b hb => fun D s hs => st_ty_lam D T U (ssubst (slift_sub s) b) (go (sextend T C) b U hb (sextend T D) (slift_sub s) (slift_sub_typed C D s hs T)) | st_ty_app C T U f x hf hx => fun D s hs => st_ty_app D T U (ssubst s f) (ssubst s x) (go C f (st_arrow T U) hf D s hs) (go C x T hx D s hs) end.
Definition soption_type (x : option sty) : sty := match x return sty with | None _ => st_unit | Some _ A => A end.
Definition sreplace_typed (G : sctx) (v : sterm) (B : sty) (h : styping G v B) : ssubstitution (sextend B G) G (sreplace v) := fun n => match n as k return (forall A : sty, (((sextend B G) k) = (Some sty A)) -> styping G (sreplace v k) A) with | O => fun A e => eq_transport sty (fun T => styping G v T) B A (f_equal soption_type (Some sty B) (Some sty A) e) h | S k => fun A e => st_ty_var G k A e end.
Theorem sbeta_typing : forall (G : sctx) (b v : sterm) (A B : sty), styping (sextend A G) b B -> styping G v A -> styping G (sbeta b v) B := fun G b v A B hb hv => ssubst_typing (sextend A G) b B hb G (sreplace v) (sreplace_typed G v A hv).
Definition svalue (t : sterm) : Prop := match t return Prop with | st_var n => False | st_tt => True | st_lam A b => True | st_app f x => False end.
Inductive sstep : sterm -> sterm -> Prop := | st_step_beta : forall (A : sty) (b v : sterm), svalue v -> sstep (st_app (st_lam A b) v) (sbeta b v) | st_step_fun : forall f g x : sterm, sstep f g -> sstep (st_app f x) (st_app g x) | st_step_arg : forall f x y : sterm, svalue f -> sstep x y -> sstep (st_app f x) (st_app f y).
Definition sdomain (A : sty) : sty := match A return sty with | st_unit => st_unit | st_arrow B C => B end.
Definition scodomain (A : sty) : sty := match A return sty with | st_unit => st_unit | st_arrow B C => C end.
Definition sapp_info (G : sctx) (t : sterm) (T : sty) : Prop := match t return Prop with | st_var n => True | st_tt => True | st_lam A b => True | st_app f x => ex sty (fun A => and (styping G f (st_arrow A T)) (styping G x A)) end.
Definition sapp_inversion (G : sctx) (t : sterm) (T : sty) (h : styping G t T) : sapp_info G t T := match h in styping C e A return sapp_info C e A with | st_ty_var C n A p => I | st_ty_tt C => I | st_ty_lam C A B b p => I | st_ty_app C A B f x hf hx => ex_intro sty (fun D => and (styping C f (st_arrow D B)) (styping C x D)) A (conj (styping C f (st_arrow A B)) (styping C x A) hf hx) end.
Definition slam_info (G : sctx) (t : sterm) (T : sty) : Prop := match t return Prop with | st_var n => True | st_tt => True | st_lam A b => and ((T = (st_arrow A (scodomain T)))) (styping (sextend A G) b (scodomain T)) | st_app f x => True end.
Definition slam_inversion (G : sctx) (t : sterm) (T : sty) (h : styping G t T) : slam_info G t T := match h in styping C e A return slam_info C e A with | st_ty_var C n A p => I | st_ty_tt C => I | st_ty_lam C A B b p => conj (((st_arrow A B) = (st_arrow A B))) (styping (sextend A C) b B) (eq_refl (st_arrow A B)) p | st_ty_app C A B f x hf hx => I end.
Definition sbeta_preservation (G : sctx) (A : sty) (b v : sterm) (T : sty) (h : styping G (st_app (st_lam A b) v) T) : styping G (sbeta b v) T := match sapp_inversion G (st_app (st_lam A b) v) T h return styping G (sbeta b v) T with | ex_intro _ _ D both => match both return styping G (sbeta b v) T with | conj _ _ hf hv => match slam_inversion G (st_lam A b) (st_arrow D T) hf return styping G (sbeta b v) T with | conj _ _ shape hb => sbeta_typing G b v A T hb (eq_transport sty (fun U => styping G v U) D A (f_equal sdomain (st_arrow D T) (st_arrow A T) shape) hv) end end end.
Theorem stlc_preservation : forall (t u : sterm), sstep t u -> forall (G : sctx) (A : sty), styping G t A -> styping G u A := fix go (t u : sterm) (step : sstep t u) {struct step} : forall (G : sctx) (A : sty), styping G t A -> styping G u A := match step in sstep e e2 return (forall (G : sctx) (A : sty), styping G e A -> styping G e2 A) with | st_step_beta A b v hv => fun G T h => sbeta_preservation G A b v T h | st_step_fun f g x sf => fun G T h => match sapp_inversion G (st_app f x) T h return styping G (st_app g x) T with | ex_intro _ _ A both => match both return styping G (st_app g x) T with | conj _ _ hf hx => st_ty_app G A T g x (go f g sf G (st_arrow A T) hf) hx end end | st_step_arg f x y vf sx => fun G T h => match sapp_inversion G (st_app f x) T h return styping G (st_app f y) T with | ex_intro _ _ A both => match both return styping G (st_app f y) T with | conj _ _ hf hx => st_ty_app G A T f y hf (go x y sx G A hx) end end end.
Definition scan_step (t : sterm) : Prop := ex sterm (fun u => sstep t u).
Definition sprogress (t : sterm) : Prop := or (svalue t) (scan_step t).
Definition sapply_value (G : sctx) (f : sterm) (T : sty) (h : styping G f T) : match T return Prop with | st_unit => True | st_arrow A B => forall x : sterm, svalue f -> svalue x -> scan_step (st_app f x) end := match h in styping C e U return (match U return Prop with | st_unit => True | st_arrow A B => forall x : sterm, svalue e -> svalue x -> scan_step (st_app e x) end) with | st_ty_var C n A p => match A as T return (match T return Prop with | st_unit => True | st_arrow B D => forall x : sterm, svalue (st_var n) -> svalue x -> scan_step (st_app (st_var n) x) end) with | st_unit => I | st_arrow B D => fun x v w => False_rect (scan_step (st_app (st_var n) x)) v end | st_ty_tt C => I | st_ty_lam C A B b hb => fun x v w => ex_intro sterm (fun u => sstep (st_app (st_lam A b) x) u) (sbeta b x) (st_step_beta A b x w) | st_ty_app C A B f x hf hx => match B as T return (match T return Prop with | st_unit => True | st_arrow U V => forall y : sterm, svalue (st_app f x) -> svalue y -> scan_step (st_app (st_app f x) y) end) with | st_unit => I | st_arrow U V => fun y v w => False_rect (scan_step (st_app (st_app f x) y)) v end end.
Definition sempty_context (G : sctx) : Prop := forall (n : nat) (A : sty), ((G n) = (Some sty A)) -> False.
Definition sempty_valid : sempty_context sempty := fun n A e => match e in eq _ x return (match x return Prop with | None _ => True | Some _ T => False end) with | eq_refl _ => I end.
Definition sprogress_general : forall (G : sctx) (t : sterm) (A : sty), styping G t A -> sempty_context G -> sprogress t := fix go (G : sctx) (t : sterm) (A : sty) (h : styping G t A) {struct h} : sempty_context G -> sprogress t := match h in styping C e T return (sempty_context C -> sprogress e) with | st_ty_var C n T p => fun empty => False_rect (sprogress (st_var n)) (empty n T p) | st_ty_tt C => fun empty => or_introl (svalue st_tt) (scan_step st_tt) I | st_ty_lam C T U b hb => fun empty => or_introl (svalue (st_lam T b)) (scan_step (st_lam T b)) I | st_ty_app C T U f x hf hx => fun empty => match go C f (st_arrow T U) hf empty return sprogress (st_app f x) with | or_introl _ _ vf => match go C x T hx empty return sprogress (st_app f x) with | or_introl _ _ vx => or_intror (svalue (st_app f x)) (scan_step (st_app f x)) (sapply_value C f (st_arrow T U) hf x vf vx) | or_intror _ _ sx => match sx return sprogress (st_app f x) with | ex_intro _ _ y step => or_intror (svalue (st_app f x)) (scan_step (st_app f x)) (ex_intro sterm (fun z => sstep (st_app f x) z) (st_app f y) (st_step_arg f x y vf step)) end end | or_intror _ _ sf => match sf return sprogress (st_app f x) with | ex_intro _ _ g step => or_intror (svalue (st_app f x)) (scan_step (st_app f x)) (ex_intro sterm (fun z => sstep (st_app f x) z) (st_app g x) (st_step_fun f g x step)) end end end.
Theorem stlc_progress : forall (t : sterm) (A : sty), styping sempty t A -> or (svalue t) (ex sterm (fun u => sstep t u)) := fun t A h => sprogress_general sempty t A h sempty_valid.
Inductive smulti : sterm -> sterm -> Prop := | st_multi_refl : forall t : sterm, smulti t t | st_multi_step : forall t u v : sterm, sstep t u -> smulti u v -> smulti t v.
Theorem stlc_preservation_many : forall (t u : sterm), smulti t u -> forall (G : sctx) (A : sty), styping G t A -> styping G u A := fix go (t u : sterm) (h : smulti t u) {struct h} : forall (G : sctx) (A : sty), styping G t A -> styping G u A := match h in smulti e f return (forall (G : sctx) (A : sty), styping G e A -> styping G f A) with | st_multi_refl e => fun G A p => p | st_multi_step e f g step rest => fun G A p => go f g rest G A (stlc_preservation e f step G A p) end.
Definition sstuck (t : sterm) : Prop := and (not (svalue t)) (not (scan_step t)).
Theorem stlc_safety : forall (t u : sterm) (A : sty), styping sempty t A -> smulti t u -> not (sstuck u) := fun t u A typed steps stuck => match stuck return False with | conj _ _ nv ns => match stlc_progress u A (stlc_preservation_many t u steps sempty A typed) return False with | or_introl _ _ v => nv v | or_intror _ _ s => ns s end end.
Definition sidentity : sterm := st_lam st_unit (st_var O).
Definition sidentity_typing : styping sempty sidentity (st_arrow st_unit st_unit) := st_ty_lam sempty st_unit st_unit (st_var O) (st_ty_var (sextend st_unit sempty) O st_unit (eq_refl (Some sty st_unit))).
Definition sexample_typing : styping sempty (st_app sidentity st_tt) st_unit := st_ty_app sempty st_unit st_unit sidentity st_tt sidentity_typing (st_ty_tt sempty).
Definition sexample_step : sstep (st_app sidentity st_tt) st_tt := st_step_beta st_unit (st_var O) st_tt I.
Theorem substitution_avoids_capture : ((sbeta (st_lam st_unit (st_var (S O))) (st_var O)) = (st_lam st_unit (st_var (S O)))) := eq_refl (st_lam st_unit (st_var (S O))).
Theorem substitution_removes_binder : ((sbeta (st_app (st_var O) (st_var (S O))) st_tt) = (st_app st_tt (st_var O))) := eq_refl (st_app st_tt (st_var O)).
